{
  "name": "@exornea/mensura",
  "version": "0.3.0",
  "description": "Spatial math and geometry kernel for TypeScript game and editor runtimes.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./core/*": {
      "types": "./dist/core/*.d.ts",
      "default": "./dist/core/*.js"
    },
    "./geometry": {
      "types": "./dist/geometry/index.d.ts",
      "default": "./dist/geometry/index.js"
    },
    "./geometry/*": {
      "types": "./dist/geometry/*.d.ts",
      "default": "./dist/geometry/*.js"
    },
    "./query": {
      "types": "./dist/query/index.d.ts",
      "default": "./dist/query/index.js"
    },
    "./query/*": {
      "types": "./dist/query/*.d.ts",
      "default": "./dist/query/*.js"
    },
    "./collision": {
      "types": "./dist/collision/index.d.ts",
      "default": "./dist/collision/index.js"
    },
    "./collision/*": {
      "types": "./dist/collision/*.d.ts",
      "default": "./dist/collision/*.js"
    },
    "./accel": {
      "types": "./dist/accel/index.d.ts",
      "default": "./dist/accel/index.js"
    },
    "./accel/*": {
      "types": "./dist/accel/*.d.ts",
      "default": "./dist/accel/*.js"
    },
    "./world": {
      "types": "./dist/world/index.d.ts",
      "default": "./dist/world/index.js"
    },
    "./world/*": {
      "types": "./dist/world/*.d.ts",
      "default": "./dist/world/*.js"
    },
    "./layout": {
      "types": "./dist/layout/index.d.ts",
      "default": "./dist/layout/index.js"
    },
    "./layout/*": {
      "types": "./dist/layout/*.d.ts",
      "default": "./dist/layout/*.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "default": "./dist/data/index.js"
    },
    "./data/*": {
      "types": "./dist/data/*.d.ts",
      "default": "./dist/data/*.js"
    },
    "./measure": {
      "types": "./dist/measure/index.d.ts",
      "default": "./dist/measure/index.js"
    },
    "./measure/*": {
      "types": "./dist/measure/*.d.ts",
      "default": "./dist/measure/*.js"
    },
    "./validation": {
      "types": "./dist/validation/index.d.ts",
      "default": "./dist/validation/index.js"
    },
    "./validation/*": {
      "types": "./dist/validation/*.d.ts",
      "default": "./dist/validation/*.js"
    },
    "./batch": {
      "types": "./dist/batch/index.d.ts",
      "default": "./dist/batch/index.js"
    },
    "./batch/*": {
      "types": "./dist/batch/*.d.ts",
      "default": "./dist/batch/*.js"
    },
    "./physics": {
      "types": "./dist/physics/index.d.ts",
      "default": "./dist/physics/index.js"
    },
    "./gpu": {
      "types": "./dist/gpu/index.d.ts",
      "default": "./dist/gpu/index.js"
    },
    "./gpu/*": {
      "types": "./dist/gpu/*.d.ts",
      "default": "./dist/gpu/*.js"
    },
    "./unsafe": {
      "types": "./dist/unsafe/index.d.ts",
      "default": "./dist/unsafe/index.js"
    },
    "./unsafe/*": {
      "types": "./dist/unsafe/*.d.ts",
      "default": "./dist/unsafe/*.js"
    },
    "./wasm": {
      "types": "./dist/wasm/index.d.ts",
      "default": "./dist/wasm/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "DCO.md",
    "LICENSE",
    "examples",
    "perf-benchmark.ts"
  ],
  "keywords": [
    "geometry",
    "spatial",
    "math",
    "vector",
    "aabb",
    "frustum",
    "ray",
    "game",
    "editor",
    "typescript"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:experimental": "npm run clean:experimental && tsc -p tsconfig.experimental.json",
    "build:all": "npm run build && npm run build:experimental",
    "benchmark": "npm run build && node benchmark-runner.js",
    "benchmark:check": "npm run build && node benchmark-runner.js --check",
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('dist',{recursive:true,force:true}); fs.rmSync('tsconfig.tsbuildinfo',{force:true});\"",
    "clean:all": "npm run clean && npm run clean:experimental",
    "clean:experimental": "node -e \"const fs=require('fs'); fs.rmSync('dist-experimental',{recursive:true,force:true}); fs.rmSync('tsconfig.experimental.tsbuildinfo',{force:true});\"",
    "check": "npm run build && npm test && npm run pack:check",
    "check:contracts": "npm run build && npm run build:experimental && npm run api:snapshot && npm run smoke:examples && npm run smoke:bundler && npm run smoke:browser && npm run smoke:perf-types",
    "check:release": "npm run release:stub-check && npm run dco:check && npm run check && npm run check:contracts && npm run benchmark:check",
    "dco:check": "node scripts/dco-check.mjs",
    "example:collision": "npm run build && node examples/collision-source-of-truth.mjs",
    "api:snapshot": "node scripts/api-snapshot.mjs",
    "api:snapshot:write": "node scripts/api-snapshot.mjs --write",
    "pack:check": "npm pack --dry-run",
    "prebuild": "npm run clean",
    "prepublishOnly": "npm run check:release",
    "prepack": "npm run build",
    "release:stub-check": "node scripts/release-stub-check.mjs",
    "smoke:examples": "node examples/collision-source-of-truth.mjs && node examples/geukbit-viewport-dogfood.mjs",
    "smoke:bundler": "tsc -p packages/bundler-smoke/tsconfig.json",
    "smoke:browser": "vite build --config packages/browser-smoke/vite.config.mjs",
    "smoke:perf-types": "tsc --noEmit --module NodeNext --moduleResolution NodeNext --target es2022 --lib es2022,dom --strict --exactOptionalPropertyTypes perf-benchmark.ts",
    "test": "vitest run",
    "visual:ray": "npm run build && node examples/visual-ray-fixtures.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "gl-matrix": "^3.4.4",
    "vite": "^8.0.13",
    "vitest": "^4.0.10",
    "wgpu-matrix": "^3.4.0"
  }
}

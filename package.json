{
  "name": "@exornea/mensura",
  "version": "0.0.0",
  "description": "Spatial math and geometry kernel for TypeScript game and editor runtimes.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./core/*": {
      "types": "./dist/core/*.d.ts",
      "default": "./dist/core/*.js"
    },
    "./geometry": {
      "types": "./dist/geometry/index.d.ts",
      "default": "./dist/geometry/index.js"
    },
    "./geometry/*": {
      "types": "./dist/geometry/*.d.ts",
      "default": "./dist/geometry/*.js"
    },
    "./gpu": {
      "types": "./dist/gpu/index.d.ts",
      "default": "./dist/gpu/index.js"
    },
    "./gpu/*": {
      "types": "./dist/gpu/*.d.ts",
      "default": "./dist/gpu/*.js"
    },
    "./unsafe": {
      "types": "./dist/unsafe/index.d.ts",
      "default": "./dist/unsafe/index.js"
    },
    "./unsafe/*": {
      "types": "./dist/unsafe/*.d.ts",
      "default": "./dist/unsafe/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "geometry",
    "spatial",
    "math",
    "vector",
    "aabb",
    "frustum",
    "ray",
    "game",
    "editor",
    "typescript"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "benchmark": "npm run build && node benchmark-runner.js",
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('dist',{recursive:true,force:true}); fs.rmSync('tsconfig.tsbuildinfo',{force:true});\"",
    "check": "npm run build && npm test && npm run pack:check",
    "pack:check": "npm pack --dry-run",
    "prebuild": "npm run clean",
    "prepack": "npm run build",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.0.10"
  }
}

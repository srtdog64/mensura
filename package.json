{
  "name": "@exornea/mensura",
  "version": "0.1.0",
  "description": "Spatial math and geometry kernel for TypeScript game and editor runtimes.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./core/*": {
      "types": "./dist/core/*.d.ts",
      "default": "./dist/core/*.js"
    },
    "./geometry": {
      "types": "./dist/geometry/index.d.ts",
      "default": "./dist/geometry/index.js"
    },
    "./geometry/*": {
      "types": "./dist/geometry/*.d.ts",
      "default": "./dist/geometry/*.js"
    },
    "./query": {
      "types": "./dist/query/index.d.ts",
      "default": "./dist/query/index.js"
    },
    "./query/*": {
      "types": "./dist/query/*.d.ts",
      "default": "./dist/query/*.js"
    },
    "./collision": {
      "types": "./dist/collision/index.d.ts",
      "default": "./dist/collision/index.js"
    },
    "./collision/*": {
      "types": "./dist/collision/*.d.ts",
      "default": "./dist/collision/*.js"
    },
    "./accel": {
      "types": "./dist/accel/index.d.ts",
      "default": "./dist/accel/index.js"
    },
    "./accel/*": {
      "types": "./dist/accel/*.d.ts",
      "default": "./dist/accel/*.js"
    },
    "./world": {
      "types": "./dist/world/index.d.ts",
      "default": "./dist/world/index.js"
    },
    "./world/*": {
      "types": "./dist/world/*.d.ts",
      "default": "./dist/world/*.js"
    },
    "./layout": {
      "types": "./dist/layout/index.d.ts",
      "default": "./dist/layout/index.js"
    },
    "./layout/*": {
      "types": "./dist/layout/*.d.ts",
      "default": "./dist/layout/*.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "default": "./dist/data/index.js"
    },
    "./data/*": {
      "types": "./dist/data/*.d.ts",
      "default": "./dist/data/*.js"
    },
    "./measure": {
      "types": "./dist/measure/index.d.ts",
      "default": "./dist/measure/index.js"
    },
    "./measure/*": {
      "types": "./dist/measure/*.d.ts",
      "default": "./dist/measure/*.js"
    },
    "./validation": {
      "types": "./dist/validation/index.d.ts",
      "default": "./dist/validation/index.js"
    },
    "./validation/*": {
      "types": "./dist/validation/*.d.ts",
      "default": "./dist/validation/*.js"
    },
    "./batch": {
      "types": "./dist/batch/index.d.ts",
      "default": "./dist/batch/index.js"
    },
    "./batch/*": {
      "types": "./dist/batch/*.d.ts",
      "default": "./dist/batch/*.js"
    },
    "./physics": {
      "types": "./dist/physics/index.d.ts",
      "default": "./dist/physics/index.js"
    },
    "./gpu": {
      "types": "./dist/gpu/index.d.ts",
      "default": "./dist/gpu/index.js"
    },
    "./gpu/*": {
      "types": "./dist/gpu/*.d.ts",
      "default": "./dist/gpu/*.js"
    },
    "./unsafe": {
      "types": "./dist/unsafe/index.d.ts",
      "default": "./dist/unsafe/index.js"
    },
    "./unsafe/*": {
      "types": "./dist/unsafe/*.d.ts",
      "default": "./dist/unsafe/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "geometry",
    "spatial",
    "math",
    "vector",
    "aabb",
    "frustum",
    "ray",
    "game",
    "editor",
    "typescript"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "benchmark": "npm run build && node benchmark-runner.js",
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('dist',{recursive:true,force:true}); fs.rmSync('tsconfig.tsbuildinfo',{force:true});\"",
    "check": "npm run build && npm test && npm run pack:check",
    "pack:check": "npm pack --dry-run",
    "prebuild": "npm run clean",
    "prepack": "npm run build",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "gl-matrix": "^3.4.4",
    "vitest": "^4.0.10",
    "wgpu-matrix": "^3.4.0"
  }
}

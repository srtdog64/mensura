{
  "compilerOptions": {
    "exactOptionalPropertyTypes": true,
    "baseUrl": "../..",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@exornea/mensura": ["dist/index.d.ts"],
      "@exornea/mensura/*": ["dist/*/index.d.ts", "dist/*.d.ts"]
    },
    "strict": true,
    "target": "ES2022",
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts"]
}
